NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/business-empire?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-long-random-string
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_DECISION_WINDOW_MS=60000
RATE_LIMIT_DECISION_MAX=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@businessempire.local
PUBLIC_APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678

# Netlify production (set these in Site configuration > Environment variables):
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...
# JWT_ACCESS_SECRET=long-random-string
# JWT_REFRESH_SECRET=long-random-string
# CSRF_SECRET=long-random-string
# CORS_ORIGINS=https://YOUR-SITE.netlify.app
# PUBLIC_APP_URL=https://YOUR-SITE.netlify.app
